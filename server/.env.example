MONGO_URI=
JWT_SECRET=
GEMINI_API_KEY=
PORT=5000
UPLOAD_DIR=uploads

# Local Ollama adaptive-question generation
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=45000
MAX_GENERATION_ATTEMPTS=3
ADAPTIVE_OVERALL_QUESTIONS_PER_MILESTONE=3
ADAPTIVE_OVERALL_MAX_QUESTIONS=25
ADAPTIVE_MILESTONE_QUESTION_COUNT=15

# Email verification (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
FRONTEND_URL=http://localhost:5173

# Optional: a PEM CA bundle for a trusted enterprise TLS-inspection proxy.
# Do not set EMAIL_TLS_REJECT_UNAUTHORIZED=false.
EMAIL_TLS_CA_PATH=
